# Copied to .env by ./setup, which fills in POSTGRES_PASSWORD. .env is git-ignored.

# The Matrix server name: the part after the colon in user ids (@you:<SERVER_NAME>).
# PERMANENT: it cannot be changed after the first start without wiping everything.
# It does not need to resolve anywhere. A domain you own (kybar.win) is the best choice:
# it keeps federation possible later and can never clash with someone else's server.
SERVER_NAME=

# Your Matrix username (the part between @ and the colon). ./setup creates it.
ADMIN_USER=

# The URL clients use to reach Synapse through Envoy (HTTPS, see ../certs).
PUBLIC_URL=https://matrix.home.kybar.win/

# Generated by ./setup. Hex only, because it is embedded in database URLs.
POSTGRES_PASSWORD=
